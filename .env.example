# ==============================================================================
# CAMPUSOPS ENVIRONMENT VARIABLES (PHASE 2.8 PERSISTENCE & INTEGRATION)
# Copy this file to .env or .env.local to configure your local environment.
# NEVER COMMIT .env OR .env.local TO GIT. NEVER EXPOSE SERVICE KEYS IN CLIENT.
# ==============================================================================

# --- Frontend Configuration (Vite) ---
# Public Supabase URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Public Supabase Anon Key (Safe for browser client)
VITE_SUPABASE_ANON_KEY=

# Backend Express API URL (e.g. http://localhost:5000)
VITE_API_URL=http://localhost:5000

# Explicit Demo Mode Flag (Set to "true" to force local demo data without DB)
# In production, leave empty or set to "false" to enforce real database persistence.
VITE_DEMO_MODE=false

# App Branding
VITE_APP_NAME=CampusOps
VITE_APP_VERSION=2.8.0
VITE_CAMPUS_NAME=Evergreen University

# --- Backend Configuration (Express Server) ---
# Express Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server-side Supabase URL (same as VITE_SUPABASE_URL or internal URL)
SUPABASE_URL=

# Server-side Anon Key
SUPABASE_ANON_KEY=

# Server-side Service Role Key (NEVER expose to client/browser!)
SUPABASE_SERVICE_ROLE_KEY=

